TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Required; private chats only.
ALLOWED_USER_IDS=
BACKUP_DIR=./backups
STATE_DIR=./state
# Optional read token for private/gated Hugging Face repositories.
HF_TOKEN=
# Refuse jobs whose selected files exceed this size (GiB).
MAX_MODEL_GB=100
# Leave at least this much disk space free (GiB).
MIN_FREE_GB=5
