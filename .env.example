TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Required; private chats only.
ALLOWED_USER_IDS=
BACKUP_DIR=./backups
STATE_DIR=./state
# Optional read token for private/gated Hugging Face repositories.
HF_TOKEN=
# Refuse jobs whose selected files exceed this size (GiB).
MAX_MODEL_GB=100
# Leave at least this much disk space free (GiB).
MIN_FREE_GB=5
# Automatic retries per planning/file operation on HTTP 429 (0 disables retries).
HF_MAX_RETRIES=5
HF_RETRY_BASE_SECONDS=30
# Cap for fallback exponential backoff; server Retry-After can be longer.
HF_RETRY_MAX_SECONDS=600
