TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
HF_TOKEN=
MAX_MODEL_GB=100
MIN_FREE_GB=5
HF_MAX_RETRIES=5
HF_RETRY_BASE_SECONDS=30
HF_RETRY_MAX_SECONDS=600

# DS925+ uses an AMD x86-64 CPU. Use linux/arm64 only for an ARM64 NAS.
DOCKER_PLATFORM=linux/amd64

# Set these to the UID/GID of a DSM user with read/write access to both folders.
# 1026:100 is only an example; check your NAS user before deploying.
PUID=1026
PGID=100

# Host paths on your NAS. Create both folders BEFORE starting the project.
# Change /volume1 if your shared folders live on another volume.
NAS_BACKUP_DIR=/volume1/AIModels
NAS_STATE_DIR=/volume1/docker/telegram-model-backup/state
